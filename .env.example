# ---- Google Gemini (https://aistudio.google.com/apikey) ----
# Free tier, no credit card required.
GEMINI_API_KEY=
# Free tier is Flash-family models only. List what your key can use with:
#   npm run check:models
#
# Note: the listing includes some models that return 404 when actually called,
# and free-tier capacity is uneven between them - gemini-flash-latest was seen
# returning 503 on every large request while gemini-3.5-flash served the same
# prompt fine. The app falls back through several models automatically, so this
# is a preference rather than a hard requirement.
GEMINI_MODEL=gemini-3.5-flash

# ---- Supabase (https://supabase.com/dashboard) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Supabase service role (server only, NEVER exposed to the browser) ----
# Dashboard > Project Settings > API > service_role key.
# Writes bypass row-level security through this key, and only after the
# request has proved it holds the unlock cookie.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Owner access ----
# The password for /unlock. Generating, importing and saving need it.
# Leave blank locally and everything is unlocked.
APP_PASSWORD=

# How many live generations visitors share per day before they are served
# the saved example instead. Defaults to 15.
VISITOR_DAILY_CAP=15

