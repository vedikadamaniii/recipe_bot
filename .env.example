# ---- Google Gemini (https://aistudio.google.com/apikey) ----
# Free tier, no credit card required.
GEMINI_API_KEY=
# Free tier is Flash-family models only. Confirm the exact current id by running:
#   npm run check:models
# A moving alias that tracks the current Flash model - safer than pinning a
# version that may leave the free tier.
GEMINI_MODEL=gemini-flash-latest

# ---- Supabase (https://supabase.com/dashboard) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Quota guard ----
# Comma-separated emails allowed to spend Gemini quota.
# Everyone else can sign in and browse, but cannot generate.
ALLOWED_EMAILS=
